const SPREADSHEET_ID='YOUR_SPREADSHEET_ID';const TZ='Asia/Dhaka',ORDER_SHEET='Orders',SETTINGS_SHEET='Settings',ADMINS_SHEET='Admins';const HEADERS=['Order ID','Created At','Updated At','Customer Name','Phone','Division','District','Upazila','Full Address','Product Name','Variant','Color','Size','Quantity','Unit Price','Subtotal','Discount','Delivery Charge','Total Amount','Payment Method','Order Status','Customer Note','Admin Note','Client Request ID'];function jsonResponse(x){return ContentService.createTextOutput(JSON.stringify(x)).setMimeType(ContentService.MimeType.JSON)}function ok(message,data){return jsonResponse({success:true,message:message||'OK',data:data||{}})}function fail(message){return jsonResponse({success:false,message:message||'অনুরোধটি সম্পন্ন করা যায়নি।'})}function doGet(e){try{const a=e.parameter.action||'getSettings';if(a==='getSettings')return ok('',getSettings());if(a==='getProduct')return ok('',getProduct());if(a==='getReviews')return ok('',getPublicRows('Reviews'));if(a==='getFaq')return ok('',getPublicRows('FAQ'));if(a==='getOrders')return adminAction(e.parameter.token,()=>getOrders());if(a==='getOrder')return adminAction(e.parameter.token,()=>getOrder(e.parameter.id));return fail('অজানা অনুরোধ।')}catch(e){return fail('সার্ভার ত্রুটি।')}}function doPost(e){try{const p=JSON.parse(e.postData.contents||'{}'),a=p.action;if(a==='createOrder')return handleCreateOrder(p);if(a==='adminLogin')return handleAdminLogin(p);if(a==='adminLogout')return ok('',removeSession(p.token));if(a==='getOrders')return adminAction(p.token,()=>getOrders());if(a==='updateOrderStatus')return adminAction(p.token,()=>updateStatus(p));if(a==='updateAdminNote')return adminAction(p.token,()=>updateNote(p));return fail('অজানা অনুরোধ।')}catch(e){return fail('অনুরোধটি সঠিক নয়।')}}function sheet(n){return SpreadsheetApp.openById(SPREADSHEET_ID).getSheetByName(n)}function rows(n){const s=sheet(n),v=s.getDataRange().getValues();return v.length<2?[]:v.slice(1)}function getSettings(){const o={};rows(SETTINGS_SHEET).forEach(r=>o[String(r[0])]=r[1]);return o}function getProduct(){const s=getSettings();return {name:s.PRODUCT_NAME||'প্রিমিয়াম প্রোডাক্ট',salePrice:Number(s.SALE_PRICE||999),originalPrice:Number(s.ORIGINAL_PRICE||1500),stock:true}}function clean(x,max){return String(x==null?'':x).trim().replace(/[<>]/g,'').slice(0,max)}function phone(x){return String(x).replace(/[\s-]/g,'').replace(/^\+880/,'0').replace(/^880/,'0')}function validate(p){const c=p.customer||{},pr=p.product||{};if(!clean(c.name,80)||!/^01[3-9]\d{8}$/.test(phone(c.phone))||!clean(c.division,40)||!clean(c.district,40)||!clean(c.upazila,60)||!clean(c.address,300))throw Error('invalid');const q=Number(pr.quantity);if(!Number.isInteger(q)||q<1||q>10)throw Error('invalid');return {c,pr,q}}function delivery(c,s){return c.division==='ঢাকা'&&c.district==='ঢাকা'?Number(s.INSIDE_DHAKA_DELIVERY||80):Number(s.OUTSIDE_DHAKA_DELIVERY||120)}function handleCreateOrder(p){const {c,pr,q}=validate(p),s=getSettings(),prod=getProduct(),client=clean(p.clientRequestId,80);if(client&&rows(ORDER_SHEET).some(r=>String(r[23])===client))return fail('এই অর্ডারটি ইতোমধ্যে গ্রহণ করা হয়েছে।');const unit=prod.salePrice,sub=unit*q,del=delivery(c,s),total=sub+del,now=new Date(),id=generateOrderId();sheet(ORDER_SHEET).appendRow([id,Utilities.formatDate(now,TZ,'yyyy-MM-dd HH:mm:ss'),Utilities.formatDate(now,TZ,'yyyy-MM-dd HH:mm:ss'),clean(c.name,80),phone(c.phone),clean(c.division,40),clean(c.district,40),clean(c.upazila,60),clean(c.address,300),prod.name,clean(pr.variant,50),clean(pr.color,40),clean(pr.size,30),q,unit,sub,0,del,total,'Cash on Delivery','Pending',clean(p.note,300),'',client]);return ok('অর্ডার সফলভাবে গ্রহণ করা হয়েছে',{orderId:id,total:total})}function generateOrderId(){const l=LockService.getScriptLock();l.waitLock(15000);try{const s=sheet(ORDER_SHEET),d=Utilities.formatDate(new Date(),TZ,'yyyyMMdd'),n=Math.max(0,s.getLastRow()-1)+1;return `SP-${d}-${String(n).padStart(6,'0')}`}finally{l.releaseLock()}}function getOrders(){return rows(ORDER_SHEET).map(r=>({id:r[0],createdAt:r[1],name:r[3],phone:r[4],division:r[5],district:r[6],upazila:r[7],address:r[8],product:r[9],quantity:r[13],unitPrice:r[14],subtotal:r[15],discount:r[16],delivery:r[17],total:r[18],status:r[20],note:r[22]})).reverse()}function getOrder(id){return getOrders().find(x=>x.id===id)||null}function updateStatus(p){const allowed=['Pending','Confirmed','Processing','Shipped','Delivered','Cancelled','Returned'];if(!allowed.includes(p.status))throw Error();return updateCell(p.orderId,21,p.status)}function updateNote(p){return updateCell(p.orderId,23,clean(p.note,500))}function updateCell(id,col,value){const s=sheet(ORDER_SHEET),v=s.getDataRange().getValues(),i=v.findIndex((r,n)=>n>0&&String(r[0])===String(id));if(i<1)throw Error();s.getRange(i+1,col).setValue(value);s.getRange(i+1,3).setValue(Utilities.formatDate(new Date(),TZ,'yyyy-MM-dd HH:mm:ss'));return {updated:true}}function handleAdminLogin(p){const admins=rows(ADMINS_SHEET),u=admins.find(r=>String(r[1])===clean(p.username,80)&&String(r[4]).toLowerCase()==='true');if(!u||!verifyHash(p.password,String(u[2])))return fail('লগইন তথ্য সঠিক নয়।');const t=Utilities.getUuid(),cache=CacheService.getScriptCache();cache.put('admin:'+t,JSON.stringify({user:u[1]}),21600);return ok('',{token:t,expiresIn:21600})}function verifyHash(password,stored){const digest=Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256,password,Utilities.Charset.UTF_8);const hex=digest.map(b=>(b<0?b+256:b).toString(16).padStart(2,'0')).join('');return hex===stored}function adminAction(token,fn){if(!token||!CacheService.getScriptCache().get('admin:'+token))return fail('অনুমতি নেই।');try{return ok('',fn())}catch(e){return fail('অনুরোধটি সম্পন্ন করা যায়নি।')}}function removeSession(t){if(t)CacheService.getScriptCache().remove('admin:'+t);return {loggedOut:true}}function getPublicRows(n){return rows(n).filter(r=>String(r[5]||r[3]).toLowerCase()==='true').map(r=>n==='Reviews'?{name:r[1],rating:r[2],review:r[3],image:r[4]}:{question:r[1],answer:r[2]})}
